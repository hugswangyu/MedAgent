# Next.js server-side upstreams. Browser requests stay same-origin.
MEDAGENT_API_BASE=http://127.0.0.1:8000
MEDLIVE_API_BASE=http://127.0.0.1:9821
# Backward-compatible alias: LIVERAG_API_BASE

# Optional LiveKit Agents UI configuration endpoint.
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=

# LiveKit credentials and provider secrets belong to the medlive Python services,
# not to the browser-facing Next.js process.
