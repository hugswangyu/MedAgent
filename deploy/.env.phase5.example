# Copy to deploy/.env.phase5 for local use. Values here are non-production examples.
COMPOSE_PROJECT_NAME=medagent
MEDRAG_ENV=dev
ALLOW_PUBLIC_REGISTRATION=false

POSTGRES_USER=medagent
POSTGRES_DB=medagent
POSTGRES_PORT=5432
MEDAGENT_PORT=8000
MEDLIVE_API_PORT=9821
LIGHTRAG_PORT=9721
NEXTJS_PORT=3000
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881

ES_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=phase5-local-neo4j-only
MINIO_ROOT_USER=phase5-local-minio
MINIO_ROOT_PASSWORD=phase5-local-minio-password

# Browser clients must reach this host URL; do not use the Docker service name here.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Provider values stay blank until supplied through an operator-managed env file/secret store.
VOICE_LLM_API_KEY=
VOICE_TTS_API_KEY=
VOLCENGINE_STT_APP_ID=
VOLCENGINE_STT_ACCESS_TOKEN=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
